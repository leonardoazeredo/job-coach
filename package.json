{
  "name": "job-coach",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "prepare": "[ -e .git ] || exit 0; lefthook install",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/cv-pdf/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline:check": "node scripts/check.ts",
    "examples:check": "node scripts/check.ts --root examples/austin-backend",
    "pipeline:board": "node scripts/board.ts",
    "ci": "npm run check && npm run typecheck && npm run test && npm run examples:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "lefthook": "2.2.1",
    "mupdf": "1.28.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "allowScripts": {
    "lefthook": false
  }
}
